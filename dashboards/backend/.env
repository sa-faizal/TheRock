# Cache Configuration (in seconds)
# These values control how long different types of GitHub API responses are cached
# to minimize API calls and avoid rate limiting

# Open issues cache duration (default: 300 seconds = 5 minutes)
# Open issues change frequently, so shorter cache
CACHE_OPEN_ISSUES=300

# Closed issues cache duration (default: 3600 seconds = 1 hour)
# Closed issues rarely change, so longer cache
CACHE_CLOSED_ISSUES=3600

# Commits cache duration (default: 1800 seconds = 30 minutes)
CACHE_COMMITS=1800

# Individual issue details cache (default: 600 seconds = 10 minutes)
CACHE_ISSUE_DETAILS=600

# Issue comments cache (default: 900 seconds = 15 minutes)
CACHE_COMMENTS=900

